@inherits LayoutComponentBase
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="app-shell">
    <header class="app-topbar">
        <div style="display:flex; align-items:center; gap:20px;">
            <a href="/" class="brand-link">
                <span class="brand-glyph">M</span>
                <span>MapDoc</span>
            </a>

            <nav class="top-nav">
                <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink href="types">Types</NavLink>
                <NavLink href="functoids">Functoids</NavLink>
                <NavLink href="mappings">Mappings</NavLink>
            </nav>
        </div>

        <div class="topbar-actions">
            <a href="/api/export/bundle" target="_blank" class="btn btn-sm" title="Download portable .mapdoc.json catalog bundle">
                Export Bundle
            </a>
            <button type="button" class="btn btn-sm" @onclick="ToggleThemeAsync" title="Switch Dark / Light theme">
                @(_theme == "dark" ? "☀ Light" : "🌙 Dark")
            </button>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet style="display:none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
</div>

@code {
    private IJSObjectReference? _module;
    private string _theme = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mapperCanvas.js");
            _theme = await _module.InvokeAsync<string>("getTheme");
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _theme = _theme == "dark" ? "light" : "dark";
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setTheme", _theme);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
    }
}
