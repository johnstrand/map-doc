    // ==================== PORT & WIRE HELPERS ====================

    private MappingLink? ParseCandidateLink(string fromPortId, string toPortId)
    {
        if (_activePage is null) return null;

        var link = new MappingLink
        {
            Id = Guid.NewGuid(),
            GridPageId = _activePage.Id
        };

        if (fromPortId.StartsWith("src:", StringComparison.Ordinal))
        {
            link.SourcePropertyPath = fromPortId["src:".Length..];
        }
        else if (fromPortId.StartsWith("fn-out:", StringComparison.Ordinal) &&
                 Guid.TryParse(fromPortId["fn-out:".Length..], out var sfId))
        {
            link.SourceFunctoidInstanceId = sfId;
        }
        else
        {
            return null;
        }

        if (toPortId.StartsWith("tgt:", StringComparison.Ordinal))
        {
            link.TargetPropertyPath = toPortId["tgt:".Length..];
        }
        else if (toPortId.StartsWith("fn-in:", StringComparison.Ordinal))
        {
            var rest = toPortId["fn-in:".Length..];
            var parts = rest.Split(':');
            if (parts.Length != 2 || !Guid.TryParse(parts[0], out var tfId) || !int.TryParse(parts[1], out var pinIdx))
            {
                return null;
            }
            if (link.SourceFunctoidInstanceId == tfId)
            {
                return null; // Reject self-loop on same functoid card
            }
            link.TargetFunctoidInstanceId = tfId;
            link.TargetInputIndex = pinIdx;
        }
        else
        {
            return null;
        }

        return link;
    }

    private (string? PortId, bool RolledUp) ResolveSvgFromPort(MappingLink link, HashSet<string> visibleSrcPaths)
    {
        if (!string.IsNullOrWhiteSpace(link.SourcePropertyPath))
        {
            var (vis, rolled) = PropertyPathResolver.FindVisibleOrAncestorPath(link.SourcePropertyPath, visibleSrcPaths);
            return vis is null ? (null, false) : ($"src:{vis}", rolled);
        }
        if (link.SourceFunctoidInstanceId is Guid fid)
        {
            return ($"fn-out:{fid}", false);
        }
        return (null, false);
    }

    private (string? PortId, bool RolledUp) ResolveSvgToPort(MappingLink link, HashSet<string> visibleTgtPaths)
    {
        if (!string.IsNullOrWhiteSpace(link.TargetPropertyPath))
        {
            var (vis, rolled) = PropertyPathResolver.FindVisibleOrAncestorPath(link.TargetPropertyPath, visibleTgtPaths);
            return vis is null ? (null, false) : ($"tgt:{vis}", rolled);
        }
        if (link.TargetFunctoidInstanceId is Guid fid)
        {
            return ($"fn-in:{fid}:{link.TargetInputIndex ?? 0}", false);
        }
        return (null, false);
    }

    private List<FunctoidInputSpec> GetRenderedInputPins(MappingFunctoidInstance inst, FunctoidDefinition? def)
    {
        if (def is null) return [];
        var list = def.Inputs.Select(i => i.Clone()).ToList();

        if (def.IsVariadic && _activePage is not null)
        {
            var maxWired = _activePage.Links
                .Where(l => l.TargetFunctoidInstanceId == inst.Id && l.TargetInputIndex.HasValue)
                .Select(l => l.TargetInputIndex!.Value)
                .DefaultIfEmpty(def.Inputs.Count - 1)
                .Max();

            int targetCount = Math.Max(def.Inputs.Count, maxWired + 2);
            for (int idx = list.Count; idx < targetCount; idx++)
            {
                var extra = def.GetInputSpec(idx);
                if (extra is not null) list.Add(extra);
            }
        }

        return list;
    }

    private string GetSourcePortClass(string path)
    {
        if (_activePage is null) return string.Empty;
        var links = _activePage.Links
            .Where(l => l.SourcePropertyPath == path || (l.SourcePropertyPath?.StartsWith(path + "/", StringComparison.Ordinal) ?? false))
            .ToList();
        if (links.Count == 0) return string.Empty;

        var maxSev = links.Max(l => _report.GetLinkSeverity(l.Id));
        return maxSev switch
        {
            ValidationSeverity.Error => "connected-err",
            ValidationSeverity.Warning => "connected-warn",
            _ => "connected"
        };
    }

    private string GetTargetPortClass(string path)
    {
        if (_activePage is null) return string.Empty;
        var links = _activePage.Links
            .Where(l => l.TargetPropertyPath == path || (l.TargetPropertyPath?.StartsWith(path + "/", StringComparison.Ordinal) ?? false))
            .ToList();
        if (links.Count == 0) return string.Empty;

        var maxSev = links.Max(l => _report.GetLinkSeverity(l.Id));
        return maxSev switch
        {
            ValidationSeverity.Error => "connected-err",
            ValidationSeverity.Warning => "connected-warn",
            _ => "connected"
        };
    }

    private FunctoidDefinition? ResolveFunctoidDef(MappingFunctoidInstance inst) =>
        inst.FunctoidDefinition ?? (_functoidCatalog.TryGetValue(inst.FunctoidDefinitionId, out var d) ? d : null);

    private string DescribeLinkSource(MappingLink link)
    {
        if (!string.IsNullOrWhiteSpace(link.SourcePropertyPath))
        {
            var r = PropertyPathResolver.Resolve(_sourceType, link.SourcePropertyPath, _typeCatalog);
            return r.IsValid ? $"{r.DisplayPath} ({r.Type.FormatBadge(_typeNames)})" : link.SourcePropertyPath;
        }
        if (link.SourceFunctoidInstanceId is Guid fid && _activePage is not null)
        {
            var inst = _activePage.FunctoidInstances.FirstOrDefault(f => f.Id == fid);
            var def = inst is null ? null : ResolveFunctoidDef(inst);
            return $"{def?.Name ?? "Functoid"}.out";
        }
        return "?";
    }

    private string DescribeLinkTarget(MappingLink link)
    {
        if (!string.IsNullOrWhiteSpace(link.TargetPropertyPath))
        {
            var r = PropertyPathResolver.Resolve(_targetType, link.TargetPropertyPath, _typeCatalog);
            return r.IsValid ? $"{r.DisplayPath} ({r.Type.FormatBadge(_typeNames)})" : link.TargetPropertyPath;
        }
        if (link.TargetFunctoidInstanceId is Guid fid && _activePage is not null)
        {
            var inst = _activePage.FunctoidInstances.FirstOrDefault(f => f.Id == fid);
            var def = inst is null ? null : ResolveFunctoidDef(inst);
            var pin = def?.GetInputSpec(link.TargetInputIndex ?? 0);
            return $"{def?.Name ?? "Functoid"}.{pin?.Name ?? $"in{(link.TargetInputIndex ?? 0) + 1}"}";
        }
        return "?";
    }

    private static string FormatConfigInlinePreview(MappingFunctoidInstance inst)
    {
        var nonEmpty = inst.ConfigValues.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).ToList();
        if (nonEmpty.Count == 0) return string.Empty;
        return string.Join(", ", nonEmpty.Select(kv => $"{kv.Key}: \"{kv.Value}\""));
    }

    private int GetRequiredCanvasHeight()
    {
        if (_activePage is null || _activePage.FunctoidInstances.Count == 0) return 780;
        return (int)_activePage.FunctoidInstances.Max(f => f.Y) + 220;
    }

    private int CountAllComments() =>
        _mapping is null
            ? 0
            : _mapping.GridPages.Sum(p =>
                p.Links.Count(l => !string.IsNullOrWhiteSpace(l.Comment)) +
                p.FunctoidInstances.Count(f => !string.IsNullOrWhiteSpace(f.Comment)));

    private static List<MapperTreeNode> FilterVisibleNodes(List<MapperTreeNode> flat, string filter)
    {
        if (string.IsNullOrWhiteSpace(filter)) return flat;
        return flat.Where(n =>
            n.DisplayPath.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
            n.TypeBadge.Contains(filter, StringComparison.OrdinalIgnoreCase)).ToList();
    }

