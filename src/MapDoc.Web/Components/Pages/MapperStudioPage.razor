@page "/mappings/{MappingId:guid}"
@inject CatalogService Catalog
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(_mapping?.Name ?? "Mapper Studio") — MapDoc</PageTitle>

@if (_loading)
{
    <div class="page-wrap">
        <div class="card">Loading transformation studio...</div>
    </div>
}
else if (_mapping is null)
{
    <div class="page-wrap">
        <div class="card">
            <h2 style="margin:0 0 8px;">Mapping Not Found</h2>
            <a href="/mappings" class="btn btn-primary">← Back to Mappings</a>
        </div>
    </div>
}
else
{
    <div class="studio-root">
        <!-- TOP STUDIO TOOLBAR -->
        <div class="studio-toolbar">
            <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                <a href="/mappings" class="btn btn-xs" title="Back to Mappings list">← Mappings</a>

                @if (!string.IsNullOrWhiteSpace(_mapping.Namespace))
                {
                    <span class="pill pill-ns">@_mapping.Namespace</span>
                }
                <strong style="font-size:14.5px;">@_mapping.Name</strong>
                <button type="button" class="btn btn-xs btn-ghost" @onclick="() => _showSettingsModal = true" title="Edit mapping name, namespace, description, or base types">⚙ Settings</button>

                <span style="color:var(--border-strong);">|</span>

                <a href="/types/@_mapping.SourceTypeId" class="pill pill-Object" title="Open Source Type definition">
                    @(_sourceType?.QualifiedName ?? "Source")
                </a>
                <span style="color:var(--text-muted); font-size:11px;">──▶</span>
                <a href="/types/@_mapping.TargetTypeId" class="pill pill-Object" title="Open Target Type definition">
                    @(_targetType?.QualifiedName ?? "Target")
                </a>
            </div>

            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                <button type="button" class="btn btn-xs @(_showToolbox ? "btn-primary" : "")" @onclick="ToggleToolbox">
                    Toolbox
                </button>

                <button type="button" class="btn btn-xs" @onclick="AutoArrangeFunctoidsAsync" title="Neatly stack functoids vertically on this grid page">
                    Auto-Layout
                </button>

                <button type="button" class="btn btn-xs" @onclick="OpenExportModal">
                    Export Spec
                </button>

                <button type="button"
                        class="status-pill @(_report.ErrorCount > 0 ? "status-err" : _report.WarningCount > 0 ? "status-warn" : "status-ok")"
                        style="border:none; cursor:pointer;"
                        @onclick="() => { _showBottomDock = !_showBottomDock; _bottomTab = BottomTab.Diagnostics; }">
                    @if (_report.ErrorCount > 0)
                    {
                        <span>✕ @_report.ErrorCount Error(s) · @_report.WarningCount Warn</span>
                    }
                    else if (_report.WarningCount > 0)
                    {
                        <span>⚠ @_report.WarningCount Warning(s)</span>
                    }
                    else
                    {
                        <span>✓ Valid</span>
                    }
                </button>

                <span style="font-size:11.5px; color:var(--text-muted);">@_saveStatusText</span>
            </div>
        </div>

        <!-- BIZTALK GRID PAGE TABS BAR -->
        <div class="studio-pagebar">
            <div class="page-tabs">
                @foreach (var pageItem in _mapping.GridPages.OrderBy(p => p.SortOrder))
                {
                    var isAct = _activePage?.Id == pageItem.Id;
                    <button type="button"
                            class="page-tab @(isAct ? "active" : "")"
                            @onclick="() => SwitchGridPage(pageItem)">
                        <span>@pageItem.Name</span>
                        <span style="font-size:10.5px; opacity:0.7;">(@pageItem.Links.Count)</span>
                    </button>
                }
                <button type="button" class="btn btn-xs btn-ghost" @onclick="AddGridPageAsync" title="Add a new BizTalk-style Grid Page tab">+ Page</button>
            </div>

            @if (_activePage is not null)
            {
                <div style="display:flex; align-items:center; gap:6px;">
                    @if (_renamingPage)
                    {
                        <input class="input input-sm" style="width:150px; height:24px;" @bind="_renamePageBuffer" />
                        <button type="button" class="btn btn-xs btn-primary" @onclick="CommitRenamePageAsync">OK</button>
                        <button type="button" class="btn btn-xs" @onclick="() => _renamingPage = false">Cancel</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-xs btn-ghost" @onclick="StartRenamePage">Rename Page</button>
                        @if (_mapping.GridPages.Count > 1)
                        {
                            <button type="button" class="btn btn-xs btn-ghost" style="color:var(--err);" @onclick="DeleteActivePageAsync">Delete Page</button>
                        }
                    }
                </div>
            }
        </div>

        <!-- MAIN WORKSPACE -->
        <div class="studio-body">
            <!-- COLLAPSIBLE LEFT FUNCTOID TOOLBOX -->
            @if (_showToolbox)
            {
                <aside class="toolbox-drawer">
                    <div style="padding:8px; border-bottom:1px solid var(--border-subtle); display:flex; flex-direction:column; gap:6px;">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <strong style="font-size:12px;">Functoid Toolbox</strong>
                            <a href="/functoids" class="btn btn-xs btn-ghost" title="Create or edit Custom Functoids">+ Custom</a>
                        </div>
                        <input class="input input-sm" placeholder="Filter functoids..." @bind="_toolboxFilter" @bind:event="oninput" />
                    </div>

                    <div class="toolbox-scroll">
                        @foreach (var grp in FilteredToolboxGroups)
                        {
                            <div class="toolbox-cat-title">@grp.Key</div>
                            @foreach (var fn in grp)
                            {
                                <div class="toolbox-item"
                                     draggable="true"
                                     ondragstart="event.dataTransfer.setData('text/mapdoc-functoid', '@fn.Id'); event.dataTransfer.effectAllowed='copy';"
                                     @onclick="() => AddFunctoidToCanvasAsync(fn)"
                                     title="@fn.Description (Click or drag onto canvas)">
                                    <span class="fn-symbol-badge">@fn.Symbol</span>
                                    <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@fn.Name</span>
                                </div>
                            }
                        }
                    </div>
                </aside>
            }

            <!-- 3-PANE BIZTALK STAGE (SOURCE TREE + SVG/FUNCTOID CANVAS + TARGET TREE) -->
            <div id="@_stageElementId" class="mapper-stage">
                <!-- LEFT: SOURCE TYPE TREE -->
                <div class="tree-pane source-pane">
                    <div class="tree-header">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <strong style="font-size:12px;">SOURCE: @(_sourceType?.Name ?? "Missing")</strong>
                            <div style="display:flex; gap:3px;">
                                <button type="button" class="btn btn-xs btn-ghost" @onclick="() => ExpandAllMappedSource()" title="Expand mapped paths">Mapped</button>
                                <button type="button" class="btn btn-xs btn-ghost" @onclick="() => { _expandedSourcePaths.Clear(); RebuildTrees(); }" title="Collapse all">Collapse</button>
                            </div>
                        </div>
                        <input class="input input-sm" placeholder="Filter source properties..." @bind="_sourceFilter" @bind:event="oninput" />
                    </div>

                    <div class="tree-scroll">
                        @foreach (var node in VisibleSourceNodes)
                        {
                            var portSevClass = GetSourcePortClass(node.Path);
                            <div class="tree-row @(_selectedPropertySide == "source" && _selectedPropertyNode?.Path == node.Path ? "selected" : "")"
                                 style="padding-left:@(6 + node.Depth * 15)px;"
                                 @onclick="() => SelectPropertyNode(node, isSource: true)"
                                 title="@node.DisplayPath — @node.TypeFullDisplay @(string.IsNullOrWhiteSpace(node.Description) ? "" : $"\n{node.Description}")">

                                @if (node.CanExpand)
                                {
                                    <button type="button" class="tree-chevron" @onclick:stopPropagation="true" @onclick="() => ToggleSourceExpand(node)">
                                        @(node.IsExpanded ? "▾" : "▸")
                                    </button>
                                }
                                else
                                {
                                    <span style="width:16px; flex-shrink:0;"></span>
                                }

                                <span class="tree-name" style="flex:1;">@node.Name</span>

                                @if (node.IsRecursiveCycle)
                                {
                                    <span class="tree-cycle-flag" title="Recursive / self-referential type">↻</span>
                                }
                                @if (node.IsOptional)
                                {
                                    <span class="tree-mod-flag" title="Optional property">?</span>
                                }
                                @if (node.IsNullable)
                                {
                                    <span class="tree-mod-flag" title="Nullable property">∅</span>
                                }

                                <span class="pill pill-@node.Type.BaseKind">@node.TypeBadge</span>

                                <button type="button"
                                        class="port-pin @portSevClass"
                                        data-port-id="src:@node.Path"
                                        data-port-side="out"
                                        title="Drag to map '@node.DisplayPath' (@node.TypeFullDisplay)"></button>
                            </div>
                        }
                    </div>
                </div>

                <!-- CENTER: FUNCTOID CANVAS -->
                <div class="canvas-pane" @onclick="ClearSelectionIfCanvasBackground">
                    <div class="canvas-surface" style="min-height:@(Math.Max(780, GetRequiredCanvasHeight()))px;">
                        @if (_activePage is not null)
                        {
                            @if (_activePage.Links.Count == 0 && _activePage.FunctoidInstances.Count == 0)
                            {
                                <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; padding:24px; text-align:center;">
                                    <div style="max-width:340px; color:var(--text-muted); font-size:12.5px;">
                                        <div style="font-size:14px; font-weight:600; color:var(--text-secondary); margin-bottom:6px;">Drag between pins to map properties</div>
                                        Drag from any Source pin (left) to a Target pin (right), or drop Functoids from the Toolbox to transform values along the way.
                                    </div>
                                </div>
                            }

                            @foreach (var inst in _activePage.FunctoidInstances)
                            {
                                var def = ResolveFunctoidDef(inst);
                                var fnSev = _report.GetFunctoidSeverity(inst.Id);
                                var sevCss = fnSev == ValidationSeverity.Error ? "sev-error" : fnSev == ValidationSeverity.Warning ? "sev-warning" : "";
                                var pins = GetRenderedInputPins(inst, def);
                                var configPreview = FormatConfigInlinePreview(inst);

                                <div class="functoid-card @(_selectedFunctoid?.Id == inst.Id ? "selected" : "") @sevCss"
                                     data-functoid-id="@inst.Id"
                                     style="left:@(inst.X.ToString("0"))px; top:@(inst.Y.ToString("0"))px;"
                                     @onclick:stopPropagation="true"
                                     @onclick="() => SelectFunctoidInstance(inst)">

                                    <div class="functoid-drag-handle">
                                        <div style="display:flex; align-items:center; gap:6px; min-width:0;">
                                            <span class="fn-symbol-badge">@(def?.Symbol ?? "fx")</span>
                                            <span class="functoid-title">@(string.IsNullOrWhiteSpace(inst.LabelOverride) ? (def?.Name ?? "Unknown") : inst.LabelOverride)</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(inst.Comment))
                                        {
                                            <span title="@inst.Comment" style="font-size:11px;">💬</span>
                                        }
                                    </div>

                                    <div class="functoid-body">
                                        <div class="functoid-inputs">
                                            @foreach (var pin in pins)
                                            {
                                                var pinConnected = _activePage.Links.Any(l => l.TargetFunctoidInstanceId == inst.Id && l.TargetInputIndex == pin.Index);
                                                <div class="functoid-pin-row">
                                                    <button type="button"
                                                            class="port-pin @(pinConnected ? "connected" : "")"
                                                            data-port-id="fn-in:@inst.Id:@pin.Index"
                                                            data-port-side="in"
                                                            title="Input #@(pin.Index + 1): @pin.Name (@pin.TypeSpec.FormatDisplay(_typeNames))"></button>
                                                    <span>@pin.Name</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="functoid-output">
                                            <span>out</span>
                                            @{
                                                var outConnected = _activePage.Links.Any(l => l.SourceFunctoidInstanceId == inst.Id);
                                            }
                                            <button type="button"
                                                    class="port-pin @(outConnected ? "connected" : "")"
                                                    data-port-id="fn-out:@inst.Id"
                                                    data-port-side="out"
                                                    title="Output (@(def?.OutputType.FormatDisplay(_typeNames) ?? "any"))"></button>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(configPreview) || !string.IsNullOrWhiteSpace(inst.Comment))
                                    {
                                        <div class="functoid-meta-bar" title="@(string.IsNullOrWhiteSpace(inst.Comment) ? configPreview : inst.Comment)">
                                            @(!string.IsNullOrWhiteSpace(configPreview) ? configPreview : inst.Comment)
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- RIGHT: TARGET TYPE TREE -->
                <div class="tree-pane target-pane">
                    <div class="tree-header">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <strong style="font-size:12px;">TARGET: @(_targetType?.Name ?? "Missing")</strong>
                            <div style="display:flex; gap:3px;">
                                <button type="button" class="btn btn-xs btn-ghost" @onclick="() => ExpandAllMappedTarget()" title="Expand mapped paths">Mapped</button>
                                <button type="button" class="btn btn-xs btn-ghost" @onclick="() => { _expandedTargetPaths.Clear(); RebuildTrees(); }" title="Collapse all">Collapse</button>
                            </div>
                        </div>
                        <input class="input input-sm" placeholder="Filter target properties..." @bind="_targetFilter" @bind:event="oninput" />
                    </div>

                    <div class="tree-scroll">
                        @foreach (var node in VisibleTargetNodes)
                        {
                            var portSevClass = GetTargetPortClass(node.Path);
                            <div class="tree-row @(_selectedPropertySide == "target" && _selectedPropertyNode?.Path == node.Path ? "selected" : "")"
                                 @onclick="() => SelectPropertyNode(node, isSource: false)"
                                 title="@node.DisplayPath — @node.TypeFullDisplay @(string.IsNullOrWhiteSpace(node.Description) ? "" : $"\n{node.Description}")">

                                <button type="button"
                                        class="port-pin @portSevClass"
                                        data-port-id="tgt:@node.Path"
                                        data-port-side="in"
                                        title="Drop here to map into '@node.DisplayPath' (@node.TypeFullDisplay)"></button>

                                <span style="width:@(node.Depth * 14)px; flex-shrink:0;"></span>

                                @if (node.CanExpand)
                                {
                                    <button type="button" class="tree-chevron" @onclick:stopPropagation="true" @onclick="() => ToggleTargetExpand(node)">
                                        @(node.IsExpanded ? "▾" : "▸")
                                    </button>
                                }
                                else
                                {
                                    <span style="width:16px; flex-shrink:0;"></span>
                                }

                                <span class="tree-name" style="flex:1;">@node.Name</span>

                                @if (node.IsRecursiveCycle)
                                {
                                    <span class="tree-cycle-flag" title="Recursive / self-referential type">↻</span>
                                }
                                @if (node.IsOptional)
                                {
                                    <span class="tree-mod-flag" title="Optional property">?</span>
                                }
                                @if (node.IsNullable)
                                {
                                    <span class="tree-mod-flag" title="Nullable property">∅</span>
                                }

                                <span class="pill pill-@node.Type.BaseKind">@node.TypeBadge</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- STAGE-WIDE SVG OVERLAY FOR BÉZIER WIRES & LIVE RUBBER-BAND DRAG -->
                <svg class="mapper-svg-overlay">
                    @if (_activePage is not null)
                    {
                        var visibleSrcSet = VisibleSourceNodes.Select(n => n.Path).ToHashSet(StringComparer.Ordinal);
                        var visibleTgtSet = VisibleTargetNodes.Select(n => n.Path).ToHashSet(StringComparer.Ordinal);

                        @foreach (var link in _activePage.Links)
                        {
                            var (fromPort, srcRolledUp) = ResolveSvgFromPort(link, visibleSrcSet);
                            var (toPort, tgtRolledUp) = ResolveSvgToPort(link, visibleTgtSet);
                            if (fromPort is null || toPort is null) continue;

                            var linkSev = _report.GetLinkSeverity(link.Id);
                            var sevClass = linkSev switch
                            {
                                ValidationSeverity.Error => "wire-error",
                                ValidationSeverity.Warning => "wire-warning",
                                _ => "wire-valid"
                            };
                            var rollupClass = (srcRolledUp || tgtRolledUp) ? "wire-rollup" : "";
                            var selectedClass = _selectedLink?.Id == link.Id ? "selected" : "";

                            <g @key="link.Id"
                               class="wire-group @sevClass @rollupClass @selectedClass"
                               data-wire-id="@link.Id"
                               data-from-port="@fromPort"
                               data-to-port="@toPort">
                                <path class="wire-hit" @onclick="() => SelectLink(link)" />
                                <path class="wire-line" />

                                @if (!string.IsNullOrWhiteSpace(link.Comment))
                                {
                                    <g class="wire-comment-badge" @onclick="() => SelectLink(link)">
                                        <rect x="-12" y="-10" width="24" height="20" rx="5" fill="var(--bg-surface)" stroke="var(--border-strong)" stroke-width="1.2" />
                                        <text x="0" y="4" text-anchor="middle" font-size="11">💬</text>
                                        <title>@link.Comment</title>
                                    </g>
                                }
                            </g>
                        }
                    }

                    <path class="draft-wire-path" style="display:none;" />
                </svg>

                <div class="draft-wire-tooltip" style="display:none;"></div>
            </div>

            <!-- RIGHT INSPECTOR PANEL -->
            <aside class="inspector-drawer">
                <div style="padding:10px 12px; border-bottom:1px solid var(--border-subtle); background:var(--bg-elevated); font-weight:700; font-size:12.5px;">
                    @if (_selectedLink is not null)
                    {
                        <span>Wire / Mapping Inspector</span>
                    }
                    else if (_selectedFunctoid is not null)
                    {
                        <span>Functoid Instance Inspector</span>
                    }
                    else if (_selectedPropertyNode is not null)
                    {
                        <span>Property Inspector (@_selectedPropertySide)</span>
                    }
                    else
                    {
                        <span>Inspector</span>
                    }
                </div>

                <div class="inspector-body">
                    @if (_selectedLink is not null)
                    {
                        var lSev = _report.GetLinkSeverity(_selectedLink.Id);
                        var lDiags = _report.LinkDiagnostics.GetValueOrDefault(_selectedLink.Id) ?? [];

                        <div class="card" style="padding:10px;">
                            <div style="font-size:11px; color:var(--text-muted); font-weight:700; margin-bottom:4px;">CONNECTION</div>
                            <div style="font-size:12px;">
                                <strong>From:</strong> <code>@DescribeLinkSource(_selectedLink)</code>
                            </div>
                            <div style="font-size:12px; margin-top:4px;">
                                <strong>To:</strong> <code>@DescribeLinkTarget(_selectedLink)</code>
                            </div>

                            <div style="margin-top:8px;">
                                @if (lSev == ValidationSeverity.Error)
                                {
                                    <span class="status-pill status-err">Error</span>
                                }
                                else if (lSev == ValidationSeverity.Warning)
                                {
                                    <span class="status-pill status-warn">Warning</span>
                                }
                                else
                                {
                                    <span class="status-pill status-ok">Valid Connection</span>
                                }
                            </div>
                        </div>

                        @if (lDiags.Count > 0)
                        {
                            <div style="display:flex; flex-direction:column; gap:6px;">
                                @foreach (var d in lDiags)
                                {
                                    <div style="padding:8px 10px; border-radius:6px; font-size:12px; background:@(d.Severity == ValidationSeverity.Error ? "var(--err-soft)" : "var(--warn-soft)"); color:@(d.Severity == ValidationSeverity.Error ? "var(--err)" : "var(--warn)");">
                                        @d.Message
                                    </div>
                                }
                            </div>
                        }

                        <div>
                            <label class="field-label">Mapping Comment / Business Note</label>
                            <textarea class="input"
                                      rows="3"
                                      placeholder="Document transformation rules, edge cases, or rationale for this link..."
                                      value="@_selectedLink.Comment"
                                      @onchange="OnSelectedLinkCommentChangedAsync"></textarea>
                        </div>

                        <!-- ONE-CLICK INSERT FUNCTOID ON WIRE -->
                        <div class="card" style="padding:10px;">
                            <label class="field-label">Insert Functoid on Wire</label>
                            <div style="display:flex; gap:6px;">
                                <select class="input input-sm" @bind="_insertFunctoidDefId">
                                    @foreach (var f in _functoids.Where(x => x.Inputs.Count > 0 || x.IsVariadic))
                                    {
                                        <option value="@f.Id">@f.Name (@f.Category)</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-xs btn-primary" @onclick="InsertFunctoidOnSelectedWireAsync">Insert</button>
                            </div>
                        </div>

                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedLinkAsync">
                            Delete Wire
                        </button>
                    }
                    else if (_selectedFunctoid is not null)
                    {
                        var def = ResolveFunctoidDef(_selectedFunctoid);
                        var fDiags = _report.FunctoidDiagnostics.GetValueOrDefault(_selectedFunctoid.Id) ?? [];

                        <div class="card" style="padding:10px;">
                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                                <span class="fn-symbol-badge">@(def?.Symbol ?? "fx")</span>
                                <strong>@(def?.Name ?? "Unknown")</strong>
                            </div>
                            <div style="font-size:12px; color:var(--text-secondary);">@(def?.Description)</div>
                            @if (def is not null)
                            {
                                <div style="margin-top:6px; font-size:11.5px;">
                                    <strong>Output:</strong> <code>@def.OutputType.FormatDisplay(_typeNames)</code>
                                </div>
                            }
                        </div>

                        @if (fDiags.Count > 0)
                        {
                            @foreach (var d in fDiags)
                            {
                                <div style="padding:8px 10px; border-radius:6px; font-size:12px; background:@(d.Severity == ValidationSeverity.Error ? "var(--err-soft)" : "var(--warn-soft)"); color:@(d.Severity == ValidationSeverity.Error ? "var(--err)" : "var(--warn)");">
                                    @d.Message
                                </div>
                            }
                        }

                        <div>
                            <label class="field-label">Canvas Label Override (optional)</label>
                            <input class="input input-sm"
                                   placeholder="@(def?.Name)"
                                   value="@_selectedFunctoid.LabelOverride"
                                   @onchange="OnFunctoidLabelChangedAsync" />
                        </div>

                        @if (def is not null && def.ConfigParams.Count > 0)
                        {
                            <div class="card" style="padding:10px; display:flex; flex-direction:column; gap:8px;">
                                <div class="field-label" style="margin:0;">Configuration Parameters</div>
                                @foreach (var cp in def.ConfigParams)
                                {
                                    var curVal = _selectedFunctoid.ConfigValues.GetValueOrDefault(cp.Key, cp.DefaultValue);
                                    <div>
                                        <label style="font-size:11.5px; font-weight:600; display:block; margin-bottom:2px;">@cp.Label @(cp.IsRequired ? "*" : "")</label>
                                        <input class="input input-sm mono"
                                               placeholder="@cp.Placeholder"
                                               value="@curVal"
                                               @onchange="e => OnFunctoidConfigChangedAsync(cp.Key, e.Value?.ToString() ?? string.Empty)" />
                                        @if (!string.IsNullOrWhiteSpace(cp.Description))
                                        {
                                            <div style="font-size:10.5px; color:var(--text-muted); margin-top:2px;">@cp.Description</div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div>
                            <label class="field-label">Functoid Comment / Notes</label>
                            <textarea class="input"
                                      rows="3"
                                      placeholder="Explain why/how this functoid is used in this transformation..."
                                      value="@_selectedFunctoid.Comment"
                                      @onchange="OnSelectedFunctoidCommentChangedAsync"></textarea>
                        </div>

                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedFunctoidAsync">
                            Delete Functoid Instance
                        </button>
                    }
                    else if (_selectedPropertyNode is not null)
                    {
                        <div class="card" style="padding:10px; display:flex; flex-direction:column; gap:6px;">
                            <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase;">@_selectedPropertySide Property</div>
                            <strong class="mono" style="font-size:13px;">@_selectedPropertyNode.DisplayPath</strong>
                            <div>
                                <span class="pill pill-@_selectedPropertyNode.Type.BaseKind">@_selectedPropertyNode.TypeFullDisplay</span>
                            </div>
                            <div style="font-size:12px; color:var(--text-secondary);">
                                Nullable: <strong>@(_selectedPropertyNode.IsNullable ? "Yes" : "No")</strong> ·
                                Optional: <strong>@(_selectedPropertyNode.IsOptional ? "Yes" : "No")</strong>
                                @if (_selectedPropertyNode.ArrayDepth > 0)
                                {
                                    <span> · Array depth: <strong>@_selectedPropertyNode.ArrayDepth</strong></span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_selectedPropertyNode.Description))
                            {
                                <p style="margin:4px 0 0; font-size:12px;">@_selectedPropertyNode.Description</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="color:var(--text-secondary); font-size:12.5px; line-height:1.55;">
                            <p style="margin-top:0;"><strong>Selection Inspector</strong></p>
                            <ul style="padding-left:18px; margin:0;">
                                <li>Click any <strong>wire</strong> to inspect type validation, add a mapping comment, or insert a functoid.</li>
                                <li>Click any <strong>functoid card</strong> to configure literal parameters and add a functoid comment.</li>
                                <li>Click any <strong>property row</strong> in the Source or Target tree to view full schema details.</li>
                            </ul>
                        </div>
                    }
                </div>
            </aside>
        </div>

        <!-- COLLAPSIBLE BOTTOM VALIDATION & COMMENTS DOCK -->
        @if (_showBottomDock)
        {
            <div class="bottom-dock">
                <div class="bottom-dock-header">
                    <div style="display:flex; gap:6px;">
                        <button type="button"
                                class="btn btn-xs @(_bottomTab == BottomTab.Diagnostics ? "btn-primary" : "btn-ghost")"
                                @onclick="() => _bottomTab = BottomTab.Diagnostics">
                            Validation (@_report.ErrorCount Error(s), @_report.WarningCount Warning(s))
                        </button>
                        <button type="button"
                                class="btn btn-xs @(_bottomTab == BottomTab.Comments ? "btn-primary" : "btn-ghost")"
                                @onclick="() => _bottomTab = BottomTab.Comments">
                            Comments (@CountAllComments())
                        </button>
                    </div>
                    <button type="button" class="btn btn-xs btn-ghost" @onclick="() => _showBottomDock = false">Hide ▾</button>
                </div>

                <div class="bottom-dock-scroll">
                    @if (_bottomTab == BottomTab.Diagnostics)
                    {
                        @if (_report.Diagnostics.Count == 0)
                        {
                            <div style="padding:14px; color:var(--ok); font-weight:600;">
                                ✓ All connections and functoids across all grid pages are valid with zero warnings.
                            </div>
                        }
                        else
                        {
                            <table class="diag-table">
                                <thead>
                                    <tr>
                                        <th style="width:90px;">Severity</th>
                                        <th style="width:150px;">Grid Page</th>
                                        <th>Diagnostic Message</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in _report.Diagnostics.OrderByDescending(x => x.Severity))
                                    {
                                        <tr @onclick="() => JumpToDiagnostic(d)">
                                            <td>
                                                <span class="status-pill @(d.Severity == ValidationSeverity.Error ? "status-err" : "status-warn")">
                                                    @d.Severity
                                                </span>
                                            </td>
                                            <td>@d.GridPageName</td>
                                            <td>@d.Message</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                    else
                    {
                        <table class="diag-table">
                            <thead>
                                <tr>
                                    <th style="width:120px;">Element</th>
                                    <th style="width:150px;">Grid Page</th>
                                    <th style="width:260px;">Context</th>
                                    <th>Comment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pg in _mapping.GridPages.OrderBy(p => p.SortOrder))
                                {
                                    @foreach (var fi in pg.FunctoidInstances.Where(f => !string.IsNullOrWhiteSpace(f.Comment)))
                                    {
                                        var fDef = ResolveFunctoidDef(fi);
                                        <tr @onclick="() => { SwitchGridPage(pg); SelectFunctoidInstance(fi); }">
                                            <td><span class="pill pill-Number">Functoid</span></td>
                                            <td>@pg.Name</td>
                                            <td><code>@(fDef?.Name ?? "Functoid")</code></td>
                                            <td>@fi.Comment</td>
                                        </tr>
                                    }
                                    @foreach (var ln in pg.Links.Where(l => !string.IsNullOrWhiteSpace(l.Comment)))
                                    {
                                        <tr @onclick="() => { SwitchGridPage(pg); SelectLink(ln); }">
                                            <td><span class="pill pill-String">Wire</span></td>
                                            <td>@pg.Name</td>
                                            <td><code>@DescribeLinkSource(ln) → @DescribeLinkTarget(ln)</code></td>
                                            <td>@ln.Comment</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    </div>
}

