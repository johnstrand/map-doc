@code {
    [Parameter] public Guid MappingId { get; set; }

    private enum BottomTab { Diagnostics, Comments }

    private readonly string _stageElementId = $"mapper-stage-{Guid.NewGuid():N}";
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<MapperStudioPage>? _dotNetRef;
    private bool _stageInitialized;

    private bool _loading = true;
    private MappingDefinition? _mapping;
    private MappingGridPage? _activePage;
    private TypeDefinition? _sourceType;
    private TypeDefinition? _targetType;

    private Dictionary<Guid, TypeDefinition> _typeCatalog = [];
    private Dictionary<Guid, string> _typeNames = [];
    private List<FunctoidDefinition> _functoids = [];
    private Dictionary<Guid, FunctoidDefinition> _functoidCatalog = [];

    private HashSet<string> _expandedSourcePaths = new(StringComparer.Ordinal);
    private HashSet<string> _expandedTargetPaths = new(StringComparer.Ordinal);
    private List<MapperTreeNode> _sourceTree = [];
    private List<MapperTreeNode> _targetTree = [];
    private string _sourceFilter = string.Empty;
    private string _targetFilter = string.Empty;

    private bool _showToolbox = true;
    private string _toolboxFilter = string.Empty;
    private bool _showBottomDock = true;
    private BottomTab _bottomTab = BottomTab.Diagnostics;

    private MappingValidationReport _report = new();
    private string _saveStatusText = "✓ Saved";

    // Selection state
    private MappingLink? _selectedLink;
    private MappingFunctoidInstance? _selectedFunctoid;
    private MapperTreeNode? _selectedPropertyNode;
    private string _selectedPropertySide = string.Empty;
    private Guid _insertFunctoidDefId;

    // Grid Page rename state
    private bool _renamingPage;
    private string _renamePageBuffer = string.Empty;

    // Modals
    private bool _showSettingsModal;
    private bool _showExportModal;
    private string _exportedMarkdown = string.Empty;
    private string _copyBtnLabel = "Copy Markdown";

    public sealed record WirePreviewDto(string Severity, string Message);

    private IEnumerable<IGrouping<FunctoidCategory, FunctoidDefinition>> FilteredToolboxGroups =>
        _functoids
            .Where(f => string.IsNullOrWhiteSpace(_toolboxFilter) ||
                        f.Name.Contains(_toolboxFilter, StringComparison.OrdinalIgnoreCase) ||
                        f.Description.Contains(_toolboxFilter, StringComparison.OrdinalIgnoreCase))
            .GroupBy(f => f.Category);

    private List<MapperTreeNode> VisibleSourceNodes =>
        FilterVisibleNodes(PropertyPathResolver.FlattenVisible(_sourceTree), _sourceFilter);

    private List<MapperTreeNode> VisibleTargetNodes =>
        FilterVisibleNodes(PropertyPathResolver.FlattenVisible(_targetTree), _targetFilter);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _stageInitialized = false;

        _typeCatalog = await Catalog.GetTypeCatalogDictionaryAsync();
        _typeNames = _typeCatalog.ToDictionary(k => k.Key, v => v.Value.Name);
        _functoids = await Catalog.GetFunctoidsAsync();
        _functoidCatalog = _functoids.ToDictionary(f => f.Id);
        _insertFunctoidDefId = _functoids.FirstOrDefault(f => f.PresetKey == "preset.tostring")?.Id
                               ?? _functoids.FirstOrDefault()?.Id
                               ?? Guid.Empty;

        _mapping = await Catalog.GetMappingByIdAsync(MappingId);
        if (_mapping is not null)
        {
            _typeCatalog.TryGetValue(_mapping.SourceTypeId, out _sourceType);
            _typeCatalog.TryGetValue(_mapping.TargetTypeId, out _targetType);

            _activePage = _mapping.GridPages.OrderBy(p => p.SortOrder).FirstOrDefault();

            // Auto-expand all paths referenced across the mapping so connections are visible immediately
            ExpandAllMappedSource(rebuild: false);
            ExpandAllMappedTarget(rebuild: false);
            RebuildTrees();
            Revalidate();
        }

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mapping is null) return;

        _jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/mapperCanvas.js");
        _dotNetRef ??= DotNetObjectReference.Create(this);

        if (!_stageInitialized)
        {
            _stageInitialized = true;
            await _jsModule.InvokeVoidAsync("initMapperStage", _stageElementId, _dotNetRef);
        }
        else
        {
            await _jsModule.InvokeVoidAsync("syncMapperStage", _stageElementId);
        }
    }

    // ==================== JS-INVOKABLE DRAG-AND-DROP HANDLERS ====================

    [JSInvokable]
    public Task<WirePreviewDto> PreviewWireDropAsync(string fromPortId, string toPortId)
    {
        if (_mapping is null || _activePage is null)
        {
            return Task.FromResult(new WirePreviewDto("neutral", ""));
        }

        var candidate = ParseCandidateLink(fromPortId, toPortId);
        if (candidate is null)
        {
            return Task.FromResult(new WirePreviewDto("error", "Incompatible port directions."));
        }

        // Simulate replacing existing wire on the exact same functoid input pin if occupied
        var pageForSim = new MappingGridPage
        {
            Id = _activePage.Id,
            MappingId = _mapping.Id,
            Name = _activePage.Name,
            SortOrder = _activePage.SortOrder,
            FunctoidInstances = _activePage.FunctoidInstances.ToList(),
            Links = _activePage.Links
                .Where(l => !(candidate.TargetFunctoidInstanceId.HasValue &&
                              l.TargetFunctoidInstanceId == candidate.TargetFunctoidInstanceId &&
                              l.TargetInputIndex == candidate.TargetInputIndex))
                .ToList()
        };

        var simMapping = new MappingDefinition
        {
            Id = _mapping.Id,
            Name = _mapping.Name,
            SourceTypeId = _mapping.SourceTypeId,
            TargetTypeId = _mapping.TargetTypeId,
            GridPages = _mapping.GridPages.Select(p => p.Id == pageForSim.Id ? pageForSim : p).ToList()
        };

        var (sev, messages) = MappingValidator.PreviewCandidateLink(simMapping, pageForSim, candidate, _typeCatalog, _functoidCatalog);
        var sevStr = sev switch
        {
            ValidationSeverity.Error => "error",
            ValidationSeverity.Warning => "warning",
            _ => "valid"
        };
        var msg = messages.Count > 0 ? string.Join(" ", messages) : "✓ Compatible types";
        return Task.FromResult(new WirePreviewDto(sevStr, msg));
    }

    [JSInvokable]
    public async Task CompleteWireDropAsync(string fromPortId, string toPortId)
    {
        if (_mapping is null || _activePage is null) return;

        var newLink = ParseCandidateLink(fromPortId, toPortId);
        if (newLink is null) return;

        // Prevent exact duplicate link
        var duplicate = _activePage.Links.FirstOrDefault(l =>
            l.SourcePropertyPath == newLink.SourcePropertyPath &&
            l.SourceFunctoidInstanceId == newLink.SourceFunctoidInstanceId &&
            l.TargetPropertyPath == newLink.TargetPropertyPath &&
            l.TargetFunctoidInstanceId == newLink.TargetFunctoidInstanceId &&
            l.TargetInputIndex == newLink.TargetInputIndex);

        if (duplicate is not null)
        {
            SelectLink(duplicate);
            StateHasChanged();
            return;
        }

        // If dropping onto an already-wired functoid input pin, replace the old wire on that pin
        if (newLink.TargetFunctoidInstanceId.HasValue && newLink.TargetInputIndex.HasValue)
        {
            _activePage.Links.RemoveAll(l =>
                l.TargetFunctoidInstanceId == newLink.TargetFunctoidInstanceId &&
                l.TargetInputIndex == newLink.TargetInputIndex);
        }

        _activePage.Links.Add(newLink);
        SelectLink(newLink);
        await PersistAndRefreshAsync();
    }

    [JSInvokable]
    public async Task CommitFunctoidPositionAsync(string instanceIdStr, double x, double y)
    {
        if (_activePage is null || !Guid.TryParse(instanceIdStr, out var id)) return;
        var inst = _activePage.FunctoidInstances.FirstOrDefault(f => f.Id == id);
        if (inst is null) return;

        inst.X = x;
        inst.Y = y;
        SelectFunctoidInstance(inst);
        await PersistAndRefreshAsync(revalidate: false);
    }

    [JSInvokable]
    public async Task DropToolboxFunctoidAsync(string functoidDefIdStr, double x, double y)
    {
        if (!Guid.TryParse(functoidDefIdStr, out var defId)) return;
        if (!_functoidCatalog.TryGetValue(defId, out var def)) return;
        await AddFunctoidInstanceAtAsync(def, x, y);
    }

    // ==================== STUDIO ACTIONS ====================

    private async Task AddFunctoidToCanvasAsync(FunctoidDefinition def)
    {
        if (_activePage is null) return;
        double nextY = 36 + (_activePage.FunctoidInstances.Count * 92) % 560;
        double nextX = 180 + (_activePage.FunctoidInstances.Count / 6) * 185;
        await AddFunctoidInstanceAtAsync(def, nextX, nextY);
    }

    private async Task AddFunctoidInstanceAtAsync(FunctoidDefinition def, double x, double y)
    {
        if (_activePage is null) return;
        var defaults = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var cp in def.ConfigParams.Where(c => !string.IsNullOrEmpty(c.DefaultValue)))
        {
            defaults[cp.Key] = cp.DefaultValue;
        }

        var inst = new MappingFunctoidInstance
        {
            Id = Guid.NewGuid(),
            GridPageId = _activePage.Id,
            FunctoidDefinitionId = def.Id,
            FunctoidDefinition = def,
            X = x,
            Y = y,
            ConfigValues = defaults
        };

        _activePage.FunctoidInstances.Add(inst);
        SelectFunctoidInstance(inst);
        await PersistAndRefreshAsync();
    }

    private async Task InsertFunctoidOnSelectedWireAsync()
    {
        if (_activePage is null || _selectedLink is null) return;
        if (!_functoidCatalog.TryGetValue(_insertFunctoidDefId, out var def)) return;

        var oldLink = _selectedLink;
        var defaults = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var cp in def.ConfigParams.Where(c => !string.IsNullOrEmpty(c.DefaultValue)))
        {
            defaults[cp.Key] = cp.DefaultValue;
        }

        var inst = new MappingFunctoidInstance
        {
            Id = Guid.NewGuid(),
            GridPageId = _activePage.Id,
            FunctoidDefinitionId = def.Id,
            FunctoidDefinition = def,
            X = 195,
            Y = Math.Max(36, 48 + _activePage.FunctoidInstances.Count * 88),
            Comment = oldLink.Comment,
            ConfigValues = defaults
        };

        var linkIn = new MappingLink
        {
            Id = Guid.NewGuid(),
            GridPageId = _activePage.Id,
            SourcePropertyPath = oldLink.SourcePropertyPath,
            SourceFunctoidInstanceId = oldLink.SourceFunctoidInstanceId,
            TargetFunctoidInstanceId = inst.Id,
            TargetInputIndex = 0
        };

        var linkOut = new MappingLink
        {
            Id = Guid.NewGuid(),
            GridPageId = _activePage.Id,
            SourceFunctoidInstanceId = inst.Id,
            TargetPropertyPath = oldLink.TargetPropertyPath,
            TargetFunctoidInstanceId = oldLink.TargetFunctoidInstanceId,
            TargetInputIndex = oldLink.TargetInputIndex
        };

        _activePage.Links.Remove(oldLink);
        _activePage.FunctoidInstances.Add(inst);
        _activePage.Links.Add(linkIn);
        _activePage.Links.Add(linkOut);

        SelectFunctoidInstance(inst);
        await PersistAndRefreshAsync();
    }

    private async Task AutoArrangeFunctoidsAsync()
    {
        if (_activePage is null || _activePage.FunctoidInstances.Count == 0) return;

        // Topological column layout so chained functoids flow cleanly left -> right
        var colByInst = new Dictionary<Guid, int>();
        int GetCol(Guid id, HashSet<Guid> vis)
        {
            if (colByInst.TryGetValue(id, out var c)) return c;
            if (!vis.Add(id)) return 0;
            var upstream = _activePage.Links
                .Where(l => l.TargetFunctoidInstanceId == id && l.SourceFunctoidInstanceId.HasValue)
                .Select(l => l.SourceFunctoidInstanceId!.Value)
                .ToList();
            int col = upstream.Count == 0 ? 0 : upstream.Max(u => GetCol(u, vis)) + 1;
            colByInst[id] = col;
            vis.Remove(id);
            return col;
        }

        foreach (var f in _activePage.FunctoidInstances)
        {
            GetCol(f.Id, []);
        }

        foreach (var grp in _activePage.FunctoidInstances.GroupBy(f => colByInst.GetValueOrDefault(f.Id, 0)).OrderBy(g => g.Key))
        {
            double y = 32;
            double x = 90 + grp.Key * 205;
            foreach (var inst in grp.OrderBy(i => i.Y))
            {
                inst.X = x;
                inst.Y = y;
                y += 102;
            }
        }

        await PersistAndRefreshAsync(revalidate: false);
    }

    private async Task OnSelectedLinkCommentChangedAsync(ChangeEventArgs e)
    {
        if (_selectedLink is null) return;
        _selectedLink.Comment = e.Value?.ToString()?.Trim() ?? string.Empty;
        await PersistAndRefreshAsync(revalidate: false);
    }

    private async Task OnSelectedFunctoidCommentChangedAsync(ChangeEventArgs e)
    {
        if (_selectedFunctoid is null) return;
        _selectedFunctoid.Comment = e.Value?.ToString()?.Trim() ?? string.Empty;
        await PersistAndRefreshAsync(revalidate: false);
    }

    private async Task OnFunctoidLabelChangedAsync(ChangeEventArgs e)
    {
        if (_selectedFunctoid is null) return;
        var val = e.Value?.ToString()?.Trim();
        _selectedFunctoid.LabelOverride = string.IsNullOrWhiteSpace(val) ? null : val;
        await PersistAndRefreshAsync(revalidate: false);
    }

    private async Task OnFunctoidConfigChangedAsync(string key, string value)
    {
        if (_selectedFunctoid is null) return;
        _selectedFunctoid.ConfigValues[key] = value;
        await PersistAndRefreshAsync(revalidate: true);
    }

    private async Task DeleteSelectedLinkAsync()
    {
        if (_activePage is null || _selectedLink is null) return;
        _activePage.Links.Remove(_selectedLink);
        _selectedLink = null;
        await PersistAndRefreshAsync();
    }

    private async Task DeleteSelectedFunctoidAsync()
    {
        if (_activePage is null || _selectedFunctoid is null) return;
        var id = _selectedFunctoid.Id;
        _activePage.Links.RemoveAll(l => l.SourceFunctoidInstanceId == id || l.TargetFunctoidInstanceId == id);
        _activePage.FunctoidInstances.Remove(_selectedFunctoid);
        _selectedFunctoid = null;
        await PersistAndRefreshAsync();
    }

    // ==================== GRID PAGE MANAGEMENT ====================

    private void SwitchGridPage(MappingGridPage page)
    {
        _activePage = page;
        _renamingPage = false;
        ClearSelections();
    }

    private async Task AddGridPageAsync()
    {
        if (_mapping is null) return;
        var nextPage = new MappingGridPage
        {
            Id = Guid.NewGuid(),
            MappingId = _mapping.Id,
            Name = $"Page {_mapping.GridPages.Count + 1}",
            SortOrder = _mapping.GridPages.Count
        };
        _mapping.GridPages.Add(nextPage);
        _activePage = nextPage;
        ClearSelections();
        await PersistAndRefreshAsync();
    }

    private void StartRenamePage()
    {
        if (_activePage is null) return;
        _renamePageBuffer = _activePage.Name;
        _renamingPage = true;
    }

    private async Task CommitRenamePageAsync()
    {
        if (_activePage is null || string.IsNullOrWhiteSpace(_renamePageBuffer)) return;
        _activePage.Name = _renamePageBuffer.Trim();
        _renamingPage = false;
        await PersistAndRefreshAsync(revalidate: true);
    }

    private async Task DeleteActivePageAsync()
    {
        if (_mapping is null || _activePage is null || _mapping.GridPages.Count <= 1) return;
        _mapping.GridPages.Remove(_activePage);
        _activePage = _mapping.GridPages.OrderBy(p => p.SortOrder).First();
        ClearSelections();
        await PersistAndRefreshAsync();
    }

    private async Task SaveSettingsAsync()
    {
        if (_mapping is null) return;
        _typeCatalog.TryGetValue(_mapping.SourceTypeId, out _sourceType);
        _typeCatalog.TryGetValue(_mapping.TargetTypeId, out _targetType);
        _showSettingsModal = false;
        RebuildTrees();
        await PersistAndRefreshAsync();
    }

    private void OpenExportModal()
    {
        if (_mapping is null) return;
        _exportedMarkdown = MappingSpecExporter.ExportMarkdown(_mapping, _typeCatalog, _functoidCatalog);
        _copyBtnLabel = "Copy Markdown";
        _showExportModal = true;
    }

    private async Task CopyMarkdownSpecAsync()
    {
        if (_jsModule is not null)
        {
            await _jsModule.InvokeAsync<bool>("copyToClipboard", _exportedMarkdown);
            _copyBtnLabel = "✓ Copied!";
        }
    }

    private void ToggleToolbox()
    {
        _showToolbox = !_showToolbox;
    }

    private void JumpToDiagnostic(ValidationDiagnostic diag)
    {
        if (_mapping is null) return;
        if (diag.GridPageId is Guid pid)
        {
            var pg = _mapping.GridPages.FirstOrDefault(p => p.Id == pid);
            if (pg is not null) _activePage = pg;
        }

        if (diag.LinkId is Guid lid && _activePage is not null)
        {
            var ln = _activePage.Links.FirstOrDefault(l => l.Id == lid);
            if (ln is not null) SelectLink(ln);
        }
        else if (diag.FunctoidInstanceId is Guid fid && _activePage is not null)
        {
            var fn = _activePage.FunctoidInstances.FirstOrDefault(f => f.Id == fid);
            if (fn is not null) SelectFunctoidInstance(fn);
        }
    }

    // ==================== TREE EXPANSION & SELECTION HELPERS ====================

    private void ToggleSourceExpand(MapperTreeNode node)
    {
        if (!_expandedSourcePaths.Remove(node.Path))
        {
            _expandedSourcePaths.Add(node.Path);
        }
        RebuildTrees();
    }

    private void ToggleTargetExpand(MapperTreeNode node)
    {
        if (!_expandedTargetPaths.Remove(node.Path))
        {
            _expandedTargetPaths.Add(node.Path);
        }
        RebuildTrees();
    }

    private void ExpandAllMappedSource(bool rebuild = true)
    {
        if (_mapping is null) return;
        var allSrc = _mapping.GridPages.SelectMany(p => p.Links).Where(l => l.SourcePropertyPath != null).Select(l => l.SourcePropertyPath!);
        foreach (var p in PropertyPathResolver.GetAncestorPathsToExpand(allSrc))
        {
            _expandedSourcePaths.Add(p);
        }
        if (rebuild) RebuildTrees();
    }

    private void ExpandAllMappedTarget(bool rebuild = true)
    {
        if (_mapping is null) return;
        var allTgt = _mapping.GridPages.SelectMany(p => p.Links).Where(l => l.TargetPropertyPath != null).Select(l => l.TargetPropertyPath!);
        foreach (var p in PropertyPathResolver.GetAncestorPathsToExpand(allTgt))
        {
            _expandedTargetPaths.Add(p);
        }
        if (rebuild) RebuildTrees();
    }

    private void RebuildTrees()
    {
        _sourceTree = _sourceType is null
            ? []
            : PropertyPathResolver.BuildTree(_sourceType, _typeCatalog, _expandedSourcePaths);

        _targetTree = _targetType is null
            ? []
            : PropertyPathResolver.BuildTree(_targetType, _typeCatalog, _expandedTargetPaths);
    }

    private void Revalidate()
    {
        if (_mapping is null) return;
        _report = MappingValidator.Validate(_mapping, _typeCatalog, _functoidCatalog);
    }

    private async Task PersistAndRefreshAsync(bool revalidate = true)
    {
        if (_mapping is null) return;
        _saveStatusText = "Saving...";
        StateHasChanged();

        if (revalidate)
        {
            Revalidate();
        }

        await Catalog.SaveMappingGraphAsync(_mapping);
        _saveStatusText = "✓ Saved";
        StateHasChanged();
    }

